{
  "name": "bahasa-ku-vscode",
  "displayName": "Dukungan Bahasa Ku",
  "description": "Syntax Highlighting & Snippet untuk Bahasa Pemrograman Ku",
  "version": "0.1.0",
  "publisher": "zufarrizal",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ku",
        "aliases": [
          "Bahasa Ku",
          "ku"
        ],
        "extensions": [
          ".ku"
        ],
        "icon": {
          "light": "./icons/ku-icon.svg",
          "dark": "./icons/ku-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ku",
        "scopeName": "source.ku",
        "path": "./syntaxes/ku.tmLanguage.json"
      }
    ]
  }
}
